<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record voice notes for your lyric annotations. Recordings stay in your library and are included when you export a song bundle.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Singers Lyrics Song Bundle</string>
			<key>UTTypeIdentifier</key>
			<string>app.singerslyrics.song-bundle</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>singerslyrics</string>
				</array>
				<key>public.mime-type</key>
					<string>application/vnd.singerslyrics.song-bundle</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
